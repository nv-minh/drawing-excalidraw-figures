   "updated": 1,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "gia tốc a cùng hướng với hợp lực\nvd: lực đẩy 10 N, bỏ qua ma sát (nên hợp lực\n= 10 N), xe 2 kg → a = 10 / 2 = 5 m/s²,\ntức vận tốc thay đổi 5 m/s mỗi giây",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "gia tốc a cùng hướng với hợp lực\nvd: lực đẩy 10 N, bỏ qua ma sát (nên hợp lực\n= 10 N), xe 2 kg → a = 10 / 2 = 5 m/s²,\ntức vận tốc thay đổi 5 m/s mỗi giây",
   "autoResize": true,
   "lineHeight": 1.35
  },
