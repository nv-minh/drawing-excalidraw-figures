   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "a points the same way as the net force\ne.g. a 10 N push, no friction (so net force\n= 10 N), 2 kg cart → a = 10 / 2 = 5 m/s²,\nso velocity changes by 5 m/s each second",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "a points the same way as the net force\ne.g. a 10 N push, no friction (so net force\n= 10 N), 2 kg cart → a = 10 / 2 = 5 m/s²,\nso velocity changes by 5 m/s each second",
   "autoResize": true,
   "lineHeight": 1.35
  },
