   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "velocity stays the same: at rest, or straight\nat constant speed. e.g. a car at a steady\n60 km/h: driving force and drag both act on\nthe car, so they cancel: net force = 0",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "velocity stays the same: at rest, or straight\nat constant speed. e.g. a car at a steady\n60 km/h: driving force and drag both act on\nthe car, so they cancel: net force = 0",
   "autoResize": true,
   "lineHeight": 1.35
  },
