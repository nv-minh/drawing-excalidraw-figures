   "updated": 1,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Decision:\nbuy my own alarm clock\n(about 150k VND), keep the\nrule: the phone sleeps in\nthe living room",
   "fontSize": 17,
   "fontFamily": 6,
