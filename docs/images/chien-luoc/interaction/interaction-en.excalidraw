  {
   "id": "_text57",
   "type": "text",
   "x": 0,
   "y": 999,
   "width": 686.4154052734375,
   "height": 43.2,
   "angle": 0,
   "strokeColor": "#111A2B",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
