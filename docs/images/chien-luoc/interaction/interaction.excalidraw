  {
   "id": "_text57",
   "type": "text",
   "x": 0,
   "y": 999,
   "width": 652.2232055664062,
   "height": 43.2,
   "angle": 0,
   "strokeColor": "#111A2B",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "av",
   "roundness": null,
   "seed": 3109,
   "version": 2,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Vì sao có state: trả lời phải khớp yêu cầu backend vừa gửi; lệch = có người ép trình duyệt tới.\nVì sao có code_verifier: code đã qua trình duyệt, dễ bị chộp; thiếu nó thì đổi không ra token.",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Vì sao có state: trả lời phải khớp yêu cầu backend vừa gửi; lệch = có người ép trình duyệt tới.\nVì sao có code_verifier: code đã qua trình duyệt, dễ bị chộp; thiếu nó thì đổi không ra token.",
   "autoResize": true,
   "lineHeight": 1.35
  },
  {
   "id": "fZYZL3UZmA4GjdnXu1MPp",
   "type": "text",
   "x": 51.42507843017577,
   "y": 114.625,
   "width": 247.22984313964844,
   "height": 141.75,
   "angle": 0,
   "strokeColor": "#1E5AE8",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aw",
   "roundness": null,
   "seed": 3146,
   "version": 3,
   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Backend tạo code_verifier (43-128\nký tự ngẫu nhiên) và state, cất cả\nhai trong session phía server;\ncode_challenge = BASE64URL(\nSHA-256(code_verifier)). Bước 2 chỉ\nđặt cookie session id (SameSite=Lax,\nđể nó quay lại ở bước 5)",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "_s6",
   "originalText": "Backend tạo code_verifier (43-128\nký tự ngẫu nhiên) và state, cất cả\nhai trong session phía server;\ncode_challenge = BASE64URL(\nSHA-256(code_verifier)). Bước 2 chỉ\nđặt cookie session id (SameSite=Lax,\nđể nó quay lại ở bước 5)",
   "autoResize": true,
   "lineHeight": 1.35
  },
